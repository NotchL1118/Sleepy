NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

SUPABASE_AUTH_GITHUB_CLIENT_ID=
SUPABASE_AUTH_GITHUB_SECRET=

# Server-only AES-256-GCM credential keyring; generate each base64 value from 32 random bytes.
# Keep all still-referenced versions during rotation. Never prefix these with NEXT_PUBLIC_.
AI_CREDENTIAL_ACTIVE_VERSION=v1
AI_CREDENTIAL_KEYS={"v1":"<base64-32-byte-key>"}
